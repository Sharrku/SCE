<form class="sce-editor" autocomplete="off" style="--accent: {{e.color}}">

  <header class="sce-hero">
    <div class="sce-hero-art" {{#if e.image}}style="background-image: url('{{e.image}}')"{{/if}}>
      {{#unless e.image}}<i class="fa-solid fa-dragon"></i>{{/unless}}
    </div>
    <div class="sce-hero-fields">
      <input class="sce-title" type="text" name="name" value="{{e.name}}" placeholder="Boss name">
      <input class="sce-subtitle" type="text" name="subtitle" value="{{e.subtitle}}" placeholder="Subtitle, e.g. The Burning Crown">
    </div>
    <label class="sce-color" title="Accent color">
      <input type="color" name="color" value="{{e.color}}"><span>Accent</span>
    </label>
  </header>

  <nav class="sce-tabs">
    <button type="button" data-tab="story"><i class="fa-solid fa-feather-pointed"></i> Story</button>
    <button type="button" data-tab="sound"><i class="fa-solid fa-music"></i> Sound</button>
    <button type="button" data-tab="flow"><i class="fa-solid fa-diagram-next"></i> After Intro</button>
    <button type="button" data-tab="combat"><i class="fa-solid fa-swords"></i> Combat</button>
    <button type="button" data-tab="ending"><i class="fa-solid fa-flag-checkered"></i> Ending</button>
  </nav>

  <div class="sce-body">

    <!-- STORY -->
    <section class="sce-pane" data-tab="story">
      <div class="sce-field">
        <label>Boss artwork</label>
        <file-picker type="image" name="image" value="{{e.image}}"></file-picker>
        <small>Shown large in the reveal, and used as the scene background if you create a scene.</small>
      </div>
      <div class="sce-field">
        <label>Narration</label>
        <textarea name="narration" rows="5" placeholder="One line per beat.&#10;Each line fades in on the darkened scene before the artwork appears.">{{e.narration}}</textarea>
        <small>One line per beat, about 3.5 seconds each.</small>
      </div>
      <div class="sce-field">
        <label>Atmosphere</label>
        <div class="sce-chips">
          {{#each atmosphereList}}
          <label class="sce-chip"><input type="radio" name="atmosphere" value="{{value}}" {{checked checked}}><i class="fa-solid {{icon}}"></i><span>{{label}}</span></label>
          {{/each}}
        </div>
      </div>
      <div class="sce-field inline">
        <label>Minimum intro length</label>
        <input type="number" name="duration" min="3" max="120" value="{{e.duration}}"><span class="unit">seconds</span>
      </div>
    </section>

    <!-- SOUND -->
    <section class="sce-pane" data-tab="sound">
      <div class="sce-card-group">
        <h4><i class="fa-solid fa-play"></i> Stinger <em>plays from the start of the intro</em></h4>
        <file-picker type="audio" name="stinger" value="{{e.stinger}}"></file-picker>
        <div class="sce-field inline">
          <label>Fade in</label>
          <range-picker name="stingerFadeIn" min="0" max="10" step="0.1" value="{{e.stingerFadeIn}}"></range-picker><span class="unit">s</span>
        </div>
      </div>

      <div class="sce-card-group">
        <h4><i class="fa-solid fa-bolt"></i> Reveal sound <em>takes over when the artwork appears</em></h4>
        <file-picker type="audio" name="revealSound" value="{{e.revealSound}}"></file-picker>
        <div class="sce-field inline">
          <label>Crossfade starts</label>
          <range-picker name="crossStart" min="-12" max="12" step="0.1" value="{{e.crossStart}}"></range-picker><span class="unit">s</span>
        </div>
        <div class="sce-field inline">
          <label>Crossfade length</label>
          <range-picker name="crossLen" min="0.2" max="10" step="0.1" value="{{e.crossLen}}"></range-picker><span class="unit">s</span>
        </div>
        <small>Negative start values begin the crossfade before the artwork appears. The reveal sound plays once and does not loop.</small>
        <div class="sce-timeline"></div>
      </div>

      <div class="sce-card-group">
        <h4><i class="fa-solid fa-guitar"></i> Music</h4>
        <div class="sce-field"><label>Combat music</label><file-picker type="audio" name="music" value="{{e.music}}"></file-picker></div>
        <div class="sce-field"><label>Victory music</label><file-picker type="audio" name="victoryMusic" value="{{e.victoryMusic}}"></file-picker></div>
      </div>
    </section>

    <!-- AFTER INTRO -->
    <section class="sce-pane" data-tab="flow">
      <div class="sce-field">
        <label>When the reveal is on screen</label>
        <div class="sce-options">
          {{#each afterList}}
          <label class="sce-option"><input type="radio" name="afterReveal" value="{{value}}" {{checked checked}}>
            <i class="fa-solid {{icon}}"></i>
            <span><strong>{{label}}</strong><small>{{desc}}</small></span>
          </label>
          {{/each}}
        </div>
      </div>
      <div class="sce-field inline">
        <label>Reveal stays</label>
        <input type="number" name="revealHold" min="0" max="120" value="{{e.revealHold}}"><span class="unit">seconds before it decides</span>
      </div>

      <div class="sce-card-group">
        <h4><i class="fa-solid fa-image"></i> Theatre scene</h4>
        <label class="sce-switch"><input type="checkbox" name="theatreScene" {{checked e.theatreScene}}><span></span> Create a scene and switch everyone to it after the intro</label>
        <small>Players keep their sheets and can roll as usual. The scene is created and kept up to date automatically.</small>
        <div class="sce-field"><label>Animated background <em>optional</em></label><file-picker type="imagevideo" name="sceneBackground" value="{{e.sceneBackground}}"></file-picker><small>A .webm or .mp4 loop. Leave empty to use the boss artwork.</small></div>
        <div class="sce-field inline"><label>Weather</label><select name="sceneWeather">{{selectOptions weathers selected=e.sceneWeather}}</select></div>
      </div>
    </section>

    <!-- COMBAT -->
    <section class="sce-pane" data-tab="combat">
      <div class="sce-field"><label>Boss actor</label>
        <select name="bossActorId">{{selectOptions actors selected=e.bossActorId blank="None"}}</select>
        <small>The health bar and phases follow this actor's hit points.</small>
      </div>
      <div class="sce-field"><label>Battle map <em>optional</em></label>
        <select name="sceneId">{{selectOptions scenes selected=e.sceneId blank="Stay on the current scene"}}</select>
      </div>
      <div class="sce-field"><label>Bar title</label>
        <input type="text" name="barName" value="{{e.barName}}" placeholder="Defaults to the encounter name">
      </div>
      <div class="sce-toggles">
        <label class="sce-switch"><input type="checkbox" name="startCombat" {{checked e.startCombat}}><span></span> Start combat after the intro</label>
        <label class="sce-switch"><input type="checkbox" name="showBar" {{checked e.showBar}}><span></span> Show the boss health bar</label>
      </div>

      <div class="sce-card-group">
        <h4><i class="fa-solid fa-heart-crack"></i> Phases <em>fire once when the boss drops below a threshold</em></h4>
        <div class="sce-phases"></div>
        <button type="button" class="sce-add-phase"><i class="fa-solid fa-plus"></i> Add phase</button>
        <input type="hidden" name="phases" value="{{e.phases}}">
      </div>
    </section>

    <!-- ENDING -->
    <section class="sce-pane" data-tab="ending">
      <div class="sce-field">
        <label>Defeat effect</label>
        <div class="sce-chips">
          {{#each defeatList}}
          <label class="sce-chip"><input type="radio" name="defeat" value="{{value}}" {{checked checked}}><i class="fa-solid {{icon}}"></i><span>{{label}}</span></label>
          {{/each}}
        </div>
      </div>
      <div class="sce-field"><label>Victory title</label><input type="text" name="victoryTitle" value="{{e.victoryTitle}}" placeholder="Victory"></div>
      <div class="sce-field"><label>Epilogue</label><textarea name="victoryText" rows="4" placeholder="A few lines shown on the victory screen.">{{e.victoryText}}</textarea></div>
    </section>
  </div>

  <footer class="sce-footer">
    <button type="button" class="sce-btn ghost" data-act="preview"><i class="fa-solid fa-film"></i> Preview (only you)</button>
    <span class="spacer"></span>
    <button type="button" class="sce-btn ghost" data-act="cancel">Cancel</button>
    <button type="submit" class="sce-btn primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
  </footer>
</form>

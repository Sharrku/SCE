<form class="ee-editor" autocomplete="off">
  <fieldset>
    <legend>Identity</legend>
    <div class="form-group"><label>Name</label><input type="text" name="name" value="{{e.name}}" placeholder="Kaldrax"></div>
    <div class="form-group"><label>Subtitle</label><input type="text" name="subtitle" value="{{e.subtitle}}" placeholder="The Burning Crown"></div>
    <div class="form-group"><label>Boss artwork</label><file-picker type="image" name="image" value="{{e.image}}"></file-picker></div>
    <div class="form-group"><label>Narration</label><textarea name="narration" rows="3" placeholder="One line per beat. Lines appear one after another.">{{e.narration}}</textarea></div>
  </fieldset>
  <fieldset>
    <legend>Look &amp; Audio</legend>
    <div class="form-group"><label>Atmosphere</label><select name="atmosphere">{{selectOptions atmospheres selected=e.atmosphere}}</select></div>
    <div class="form-group"><label>Accent color</label><input type="color" name="color" value="{{e.color}}"></div>
    <div class="form-group"><label>Min. intro length (s)</label><input type="number" name="duration" min="3" max="60" value="{{e.duration}}"></div>
    <div class="form-group"><label>Intro stinger</label><file-picker type="audio" name="stinger" value="{{e.stinger}}"></file-picker></div>
    <div class="form-group"><label>Stinger fade-in (s)</label><range-picker name="stingerFadeIn" min="0" max="10" step="0.1" value="{{e.stingerFadeIn}}"></range-picker></div>
    <div class="form-group"><label>Reveal sound</label><file-picker type="audio" name="revealSound" value="{{e.revealSound}}"></file-picker></div>
    <div class="form-group"><label>Crossfade start (s)</label><range-picker name="crossStart" min="-12" max="12" step="0.1" value="{{e.crossStart}}"></range-picker></div>
    <div class="form-group"><label>Crossfade length (s)</label><range-picker name="crossLen" min="0.2" max="10" step="0.1" value="{{e.crossLen}}"></range-picker></div>
    <p class="hint">Crossfade start is relative to the moment the artwork appears: negative starts earlier, positive starts later. The reveal sound plays once and does not loop. During the crossfade the stinger fades out while the reveal sound fades in.</p>
    <div class="form-group"><label>Reveal screen stays (s)</label><input type="number" name="revealHold" min="0" max="120" value="{{e.revealHold}}"></div>
    <div class="form-group"><label>After the reveal</label><select name="afterReveal">{{selectOptions afterRevealOptions selected=e.afterReveal}}</select></div>
    <p class="hint">Continue: ends automatically and starts combat. Ask me: shows buttons to continue or stay (theatre of the mind). Hold: stays until you close it, no combat.</p>
    <div class="form-group"><label>Combat music</label><file-picker type="audio" name="music" value="{{e.music}}"></file-picker></div>
    <div class="form-group"><label>Victory music</label><file-picker type="audio" name="victoryMusic" value="{{e.victoryMusic}}"></file-picker></div>
  </fieldset>
  <fieldset>
    <legend>Combat</legend>
    <div class="form-group"><label>Boss actor</label><select name="bossActorId">{{selectOptions actors selected=e.bossActorId blank=""}}</select></div>
    <div class="form-group"><label>Scene (optional)</label><select name="sceneId">{{selectOptions scenes selected=e.sceneId blank=""}}</select></div>
    <div class="form-group"><label>Bar name</label><input type="text" name="barName" value="{{e.barName}}" placeholder="defaults to encounter name"></div>
    <div class="form-group"><label>Start combat after intro</label><input type="checkbox" name="startCombat" {{checked e.startCombat}}></div>
    <div class="form-group"><label>Show boss bar</label><input type="checkbox" name="showBar" {{checked e.showBar}}></div>
  </fieldset>
  <fieldset>
    <legend>Theatre Scene</legend>
    <div class="form-group"><label>Create a scene</label><input type="checkbox" name="theatreScene" {{checked e.theatreScene}}></div>
    <p class="hint">Builds a scene from the artwork (or the video below) and switches everyone to it after the intro. Players can roll and open their sheets as usual. The scene is created automatically and kept up to date.</p>
    <div class="form-group"><label>Scene background</label><file-picker type="imagevideo" name="sceneBackground" value="{{e.sceneBackground}}"></file-picker></div>
    <p class="hint">Optional: an animated .webm or .mp4. Leave empty to use the boss artwork.</p>
    <div class="form-group"><label>Scene weather</label><select name="sceneWeather">{{selectOptions weathers selected=e.sceneWeather}}</select></div>
  </fieldset>
  <fieldset>
    <legend>Phases</legend>
    <p class="hint">One per line: <code>HP% | Line shown | Sound path (optional)</code> e.g. <code>65 | The wings tear loose from the stone. | sounds/roar.mp3</code>. Each fires once when the boss drops to or below that percentage; the screen shakes.</p>
    <textarea name="phases" rows="4">{{e.phases}}</textarea>
  </fieldset>
  <fieldset>
    <legend>Defeat &amp; Victory</legend>
    <div class="form-group"><label>Defeat effect</label><select name="defeat">{{selectOptions defeats selected=e.defeat}}</select></div>
    <div class="form-group"><label>Victory title</label><input type="text" name="victoryTitle" value="{{e.victoryTitle}}" placeholder="Victory"></div>
    <div class="form-group"><label>Epilogue</label><textarea name="victoryText" rows="3">{{e.victoryText}}</textarea></div>
  </fieldset>
  <footer class="form-footer"><button type="submit"><i class="fa-solid fa-save"></i> Save</button></footer>
</form>
